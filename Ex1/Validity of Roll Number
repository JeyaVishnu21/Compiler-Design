%{
#include<stdio.h>
#include<string.h>
#include<ctype.h>

FILE *out;
int count = 0;

int isValidBranch(char *branch)
{
    char upper_branch[4];
    for(int i = 0; i < 3; i++) {
        upper_branch[i] = toupper(branch[i]);
    }
    upper_branch[3] = '\0';

    if(strcmp(upper_branch, "BCS") == 0) return 1;
    if(strcmp(upper_branch, "BIT") == 0) return 1;
    if(strcmp(upper_branch, "BAI") == 0) return 1;
    if(strcmp(upper_branch, "BEE") == 0) return 1;
    if(strcmp(upper_branch, "BEC") == 0) return 1;
    if(strcmp(upper_branch, "BME") == 0) return 1;
    if(strcmp(upper_branch, "BBT") == 0) return 1;
    return 0;
}

int isValidRollNumber(char *roll)
{
    int len = strlen(roll);

    if(len != 8)
        return 0;

    if(!isdigit(roll[0]) || !isdigit(roll[1]))
        return 0;

    char branch[4];
    strncpy(branch, roll+2, 3);
    branch[3] = '\0';

    if(!isValidBranch(branch))
        return 0;

    if(!isdigit(roll[5]) || !isdigit(roll[6]) || !isdigit(roll[7]))
        return 0;

    return 1;
}
%}

%%

[0-9]{2}[a-zA-Z]{3}[0-9]{3}  {
    if(isValidRollNumber(yytext)) {
        fprintf(out, "%s\n", yytext);
        count++;
    }
}

[ \t\n]+ ;

.       ;

%%

int yywrap()
{
    return 1;
}

int main()
{
    FILE *in;

    in = fopen("student.txt", "r");
    if(in == NULL)
    {
        printf("Cannot open input file.\n");
        return 1;
    }

    out = fopen("rollnumbers.txt", "w");
    if(out == NULL)
    {
        printf("Cannot open output file.\n");
        return 1;
    }

    yyin = in;
    yylex();

    printf("Total number of students = %d\n", count);

    fclose(in);
    fclose(out);

    return 0;
}
