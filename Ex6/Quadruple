%{
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define MAX_INIT 20

int t = 1;

void quad(char *label, char *op, char *arg1, char *arg2, char *result) {
    printf("%-8s %-12s %-12s %-12s %-12s\n",
           label, op, arg1, arg2, result);
}

char init_l[MAX_INIT][20];
char init_a[MAX_INIT][20];
int init_count = 0;

char cond_a[2][20], cond_b[2][20], cond_op[2][10];
int condition_count = 0;

char inc_l[20];

extern FILE *yyin;
extern int yylex(void);
int yyerror(char *s);
%}

%union {
    char *str;
}

%token <str> ID NUM
%token FOR LE GE LT GT PLUS MINUS MUL DIV ASSIGN INCR AND
%token SEMI COMMA LPAREN RPAREN LBRACE RBRACE

%type <str> operand

%%

program
    : for_stmt
    ;

for_stmt
    : FOR LPAREN init_list SEMI condition SEMI inc RPAREN LBRACE
      {
          printf("%-8s %-12s %-12s %-12s %-12s\n",
                 "Label", "Op", "Arg1", "Arg2", "Result");

          /* Output each initialization, e.g. i=0 and j=1 */
          for (int k = 0; k < init_count; k++) {
              quad("-", "=", init_a[k], "-", init_l[k]);
          }

          /* Start of the condition check */
          quad("L2", "LABEL", "-", "-", "-");

          char temp[10];

          /* Check the first comparison */
          sprintf(temp, "T%d", t++);
          quad("-", cond_op[0], cond_a[0], cond_b[0], temp);
          quad("-", "IF_FALSE", temp, "-", "GOTO L1");

          /* Check the second comparison, if there is one */
          if (condition_count == 2) {
              sprintf(temp, "T%d", t++);
              quad("-", cond_op[1], cond_a[1], cond_b[1], temp);
              quad("-", "IF_FALSE", temp, "-", "GOTO L1");
          }
      }
      stmt_list RBRACE
      {
          /* Increment: i++ means i = i + 1 */
          char temp[10];
          sprintf(temp, "T%d", t++);
          quad("-", "+", inc_l, "1", temp);
          quad("-", "=", temp, "-", inc_l);

          /* Go back to check the condition */
          quad("-", "GOTO", "-", "-", "L2");

          /* False condition exits the loop here */
          quad("L1", "LABEL", "-", "-", "-");
      }
    ;

init_list
    : init_item
    | init_list COMMA init_item
    ;

init_item
    : ID ASSIGN operand
      {
          if (init_count >= MAX_INIT) {
              yyerror("too many initialization assignments");
              YYABORT;
          }

          strcpy(init_l[init_count], $1);
          strcpy(init_a[init_count], $3);
          init_count++;
      }
    ;

condition
    : comparison
      {
          condition_count = 1;
      }
    | comparison AND comparison
      {
          condition_count = 2;
      }
    ;

comparison
    : operand LT operand
      {
          int index = condition_count;
          strcpy(cond_op[index], "<");
          strcpy(cond_a[index], $1);
          strcpy(cond_b[index], $3);
          condition_count++;
      }
    | operand GT operand
      {
          int index = condition_count;
          strcpy(cond_op[index], ">");
          strcpy(cond_a[index], $1);
          strcpy(cond_b[index], $3);
          condition_count++;
      }
    | operand LE operand
      {
          int index = condition_count;
          strcpy(cond_op[index], "<=");
          strcpy(cond_a[index], $1);
          strcpy(cond_b[index], $3);
          condition_count++;
      }
    | operand GE operand
      {
          int index = condition_count;
          strcpy(cond_op[index], ">=");
          strcpy(cond_a[index], $1);
          strcpy(cond_b[index], $3);
          condition_count++;
      }
    ;

inc
    : ID INCR
      {
          strcpy(inc_l, $1);
      }
    ;

stmt_list
    : stmt_list stmt
    | stmt
    ;

stmt
    : ID ASSIGN operand PLUS operand SEMI
      {
          char temp[10];
          sprintf(temp, "T%d", t++);
          quad("-", "+", $3, $5, temp);
          quad("-", "=", temp, "-", $1);
      }
    | ID ASSIGN operand MINUS operand SEMI
      {
          char temp[10];
          sprintf(temp, "T%d", t++);
          quad("-", "-", $3, $5, temp);
          quad("-", "=", temp, "-", $1);
      }
    | ID ASSIGN operand MUL operand SEMI
      {
          char temp[10];
          sprintf(temp, "T%d", t++);
          quad("-", "*", $3, $5, temp);
          quad("-", "=", temp, "-", $1);
      }
    | ID ASSIGN operand DIV operand SEMI
      {
          char temp[10];
          sprintf(temp, "T%d", t++);
          quad("-", "/", $3, $5, temp);
          quad("-", "=", temp, "-", $1);
      }
    | ID ASSIGN operand SEMI
      {
          quad("-", "=", $3, "-", $1);
      }
    ;

operand
    : ID  { $$ = $1; }
    | NUM { $$ = $1; }
    ;

%%

int main(void) {
    FILE *fp = fopen("input.txt", "r");

    if (fp == NULL) {
        printf("File not found\n");
        return 1;
    }

    yyin = fp;
    int rc = yyparse();
    fclose(fp);
    return rc;
}

int yyerror(char *s) {
    fprintf(stderr, "Error: %s\n", s);
    return 0;
}

