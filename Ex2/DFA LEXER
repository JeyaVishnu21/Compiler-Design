#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define MAX 50

int num_states;
int num_symbols;
int start_state;
int num_accepting;

char states[MAX][10];
char symbols[MAX][20];
int accepting[MAX];
int trans[MAX][MAX];

// Helper to look up state index by name
int get_state_idx(char *s) {
    for (int i = 0; i < num_states; i++) {
        if (strcmp(states[i], s) == 0) return i;
    }
    return -1;
}

// Helper to look up symbol index by name
int get_symbol_idx(char *s) {
    for (int i = 0; i < num_symbols; i++) {
        if (strcmp(symbols[i], s) == 0) return i;
    }
    return -1;
}

// Helper to check if a state index is an accepting state
int is_accepting(int state) {
    for (int i = 0; i < num_accepting; i++) {
        if (accepting[i] == state) return 1;
    }
    return 0;
}

// Main processing tokenization logic
void test_string(char *input) {
    int current = start_state;
    char token[100] = {0};
    int token_len = 0;

    for (int i = 0; input[i] != '\0'; i++) {
        // Skip trailing newline character if present
        if (input[i] == '\n') continue;

        char sym[20];
        sprintf(sym, "%c", input[i]);
        int sym_idx = get_symbol_idx(sym);

        // Scenario 1: Handle completely invalid alphabet symbols
        if (sym_idx == -1) {
            // Flush any valid token accumulated right before this symbol
            if (token_len > 0) {
                if (is_accepting(current)) {
                    printf("Recognized token : <%s, %s>\n", token, states[current]);
                } else {
                    printf("Unrecognized token : %s\n", token);
                }
                token_len = 0;
                memset(token, 0, sizeof(token));
                current = start_state;
            }

            // Print only this specific invalid character as unrecognized
            printf("Unrecognized token : %c\n", input[i]);
            continue;
        }

        // Check transition table for the valid symbol
        int next = trans[current][sym_idx];

        if (next != -1) {
            // Valid transition: build onto the current token
            token[token_len++] = input[i];
            token[token_len] = '\0';
            current = next;
        } else {
            // Scenario 2: No transition available, finalize current token
            if (token_len > 0) {
                if (is_accepting(current)) {
                    printf("Recognized token : <%s, %s>\n", token, states[current]);
                } else {
                    printf("Unrecognized token : %s\n", token);
                }
            }

            // CRITICAL RESET: Wipe the token buffer entirely
            token_len = 0;
            memset(token, 0, sizeof(token));
            current = start_state;

            // Re-evaluate the current character starting fresh from the initial state
            int next2 = trans[current][sym_idx];
            if (next2 != -1) {
                token[token_len++] = input[i];
                token[token_len] = '\0';
                current = next2;
            } else {
                // If it can't even transition from the start state, it's an unrecognized single token
                printf("Unrecognized token : %c\n", input[i]);
            }
        }
    }

    // Finalize any leftover characters remaining at the end of the input string
    if (token_len > 0) {
        if (is_accepting(current)) {
            printf("Recognized token : <%s, %s>\n", token, states[current]);
        } else {
            printf("Unrecognized token : %s\n", token);
        }
    }
}

int main() {
    char temp[50];

    printf("=== DFA LEXER ===\n\n");

    printf("No. of states: ");
    scanf("%d", &num_states);
    printf("State names (space-separated): ");
    for (int i = 0; i < num_states; i++) {
        scanf("%s", states[i]);
    }

    printf("No. of symbols: ");
    scanf("%d", &num_symbols);
    printf("Symbol names (space-separated): ");
    for (int i = 0; i < num_symbols; i++) {
        scanf("%s", symbols[i]);
    }

    printf("Start state: ");
    scanf("%s", temp);
    start_state = get_state_idx(temp);

    printf("No. of accepting states: ");
    scanf("%d", &num_accepting);
    printf("Accepting state names (space-separated): ");
    for (int i = 0; i < num_accepting; i++) {
        scanf("%s", temp);
        accepting[i] = get_state_idx(temp);
    }

    printf("\nTransition table (%d states x %d symbols):\n", num_states, num_symbols);
    printf("(Use '#' for no transition/dead state)\n");
    for (int i = 0; i < num_states; i++) {
        for (int j = 0; j < num_symbols; j++) {
            scanf("%s", temp);
            if (strcmp(temp, "#") == 0) {
                trans[i][j] = -1;
            } else {
                trans[i][j] = get_state_idx(temp);
            }
        }
    }

    printf("\nDFA initialized successfully!\n");

    int choice;
    char input_str[200];

    while (1) {
        printf("\n1. Test string  2. Exit: ");
        scanf("%d", &choice);
        if (choice != 1) break;

        printf("Input string: ");
        scanf("%s", input_str);

        test_string(input_str);
    }

    return 0;
}
