%{
#include <stdio.h>
#include <stdlib.h>

extern int yylex();
extern int yylineno;
void yyerror(const char *s);
%}

/* Tokens received from the Lexer */
%token WHILE PRINT TRUE FALSE BREAK CONTINUE PASS
%token IDENTIFIER INTEGER FLOAT STRING
%token COLON EQUAL NOT_EQUAL GE LE GT LT
%token AND OR NOT
%token ASSIGN ADD_ASSIGN SUB_ASSIGN SHL_ASSIGN SHR_ASSIGN AND_ASSIGN OR_ASSIGN XOR_ASSIGN
%token SHL SHR BIT_AND BIT_OR BIT_XOR BIT_NOT
%token PLUS MINUS MULTIPLY DIVIDE MODULUS
%token LPAREN RPAREN SEMICOLON
%token INC_PREFIX DEC_PREFIX INC_POSTFIX DEC_POSTFIX
%token NEWLINE UNKNOWN

/* Operator Precedence and Associativity */
%left OR
%left AND
%right NOT
%left BIT_OR
%left BIT_XOR
%left BIT_AND
%left EQUAL NOT_EQUAL GT LT GE LE
%left SHL SHR
%left PLUS MINUS
%left MULTIPLY DIVIDE MODULUS
%right BIT_NOT UNARY_MINUS INC_PREFIX DEC_PREFIX
%left INC_POSTFIX DEC_POSTFIX

%%

/* Grammar Rules */

program:
    statements
    ;

statements:
    statements statement
    | /* empty */
    ;

statement:
    assignment NEWLINE       { printf("Parsed: Assignment Statement\n"); }
    | while_loop NEWLINE     { printf("Parsed: While Loop Structure\n"); }
    | expression NEWLINE     { printf("Parsed: Expression Statement\n"); }
    | command NEWLINE        { printf("Parsed: Standalone Command\n"); }
    | NEWLINE                { /* Ignore empty lines */ }
    ;

while_loop:
    WHILE expression COLON block { printf("Valid Python While Loop Syntax Detected!\n"); }
    ;

block:
    statement_list
    ;

/* For handling single-line compound statements separated by semicolons */
statement_list:
    inline_statement
    | statement_list SEMICOLON inline_statement
    ;

inline_statement:
    assignment
    | command
    | expression
    ;

assignment:
    IDENTIFIER ASSIGN expression
    | IDENTIFIER ADD_ASSIGN expression
    | IDENTIFIER SUB_ASSIGN expression
    | IDENTIFIER SHL_ASSIGN expression
    | IDENTIFIER SHR_ASSIGN expression
    | IDENTIFIER AND_ASSIGN expression
    | IDENTIFIER OR_ASSIGN expression
    | IDENTIFIER XOR_ASSIGN expression
    ;

command:
    PRINT LPAREN expression RPAREN { printf("Parsed: Print Function Call\n"); }
    | BREAK                        { printf("Parsed: Loop Control Break\n"); }
    | CONTINUE                     { printf("Parsed: Loop Control Continue\n"); }
    | PASS                         { printf("Parsed: Null Statement Pass\n"); }
    ;

expression:
    /* Primary Literals & Identifiers */
    IDENTIFIER
    | INTEGER
    | FLOAT
    | STRING
    | TRUE
    | FALSE
    
    /* Parentheses */
    | LPAREN expression RPAREN
    
    /* Binary Arithmetic Operators */
    | expression PLUS expression
    | expression MINUS expression
    | expression MULTIPLY expression
    | expression DIVIDE expression
    | expression MODULUS expression
    
    /* Relational Operators */
    | expression EQUAL expression
    | expression NOT_EQUAL expression
    | expression GT expression
    | expression LT expression
    | expression GE expression
    | expression LE expression
    
    /* Logical Operators */
    | expression AND expression
    | expression OR expression
    | NOT expression
    
    /* Bitwise Operators */
    | expression SHL expression
    | expression SHR expression
    | expression BIT_AND expression
    | expression BIT_OR expression
    | expression BIT_XOR expression
    
    /* Unary Operators */
    | BIT_NOT expression
    | MINUS expression %prec UNARY_MINUS { printf("Parsed Unary Minus Operation\n"); }
    | INC_PREFIX
    | DEC_PREFIX
    | INC_POSTFIX
    | DEC_POSTFIX
    ;

%%

void yyerror(const char *s) {
    fprintf(stderr, "Syntax Error: %s at line %d\n", s, yylineno);
}

int main() {
    extern FILE *yyin;
    yyin = fopen("sample.txt", "r");
    if (!yyin) {
        printf("Error: Cannot open sample.txt\n");
        return 1;
    }

    printf("--- YACC PYTHON SYNTAX ANALYZER PARSING START ---\n\n");
    if (yyparse() == 0) {
        printf("\nSuccessfully Parsed Everything! Syntax is Correct.\n");
    } else {
        printf("\nParsing Failed due to Syntax Errors.\n");
    }
    
    fclose(yyin);
    return 0;
}

