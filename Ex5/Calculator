%{
#include <stdio.h>
#include <stdlib.h>
#include "calc.tab.h"
%}

%option noyywrap

%%

[ \t]+              ; /* ignore whitespace */

[0-9]+              { yylval.ival = atoi(yytext); return INT; }

"quit"|"exit"       { return QUIT; }

"+"                 { return PLUS; }
"-"                 { return MINUS; }
"*"                 { return MUL; }
"/"                 { return DIV; }
"^"                 { return POW; }

"("                 { return LPAREN; }
")"                 { return RPAREN; }

\n                  { return NEWLINE; }

.                   { return yytext[0]; }

